     3                  ;                    10004                     
     4                  ;                  5000000047     7            
     5                  ;             7000000042400000007 7001         
     6                  ;           700097     |    74000707007       
     7                  ;         7000                  000771        
     8                  ;        7001 \        8        / 7007         
     9                  ;       7007   \       0       /   7007        
    10                  ;      7002            5            7007       
    11                  ;      700             1             001           
    12                  ;      000---         707         ---000       
    13                  ;      700             0             003     
    14                  ;       700                         7007        
    15                  ;        7007    /           \    7001         
    16                  ;         70007 /             \ 70007          
    17                  ;           70005      |      10001            
    18                  ;            7 00000001718000000               
    19                  ;                 78000000087                  
    20                  
    21                  ;------------ Setup Timers ------------
    22                  ;TIMER 0 (10ms interrupt for stopwatch timekeeping)
    23        0000      T0_G    EQU 0   ; GATE
    24        0000      T0_C    EQU 0   ; COUNTER/-TIMER 
    25        0001      T0_M    EQU 1   ; MODE 1 (16-bit)
    26        0001      TIM0    EQU T0_M+T0_C*4+T0_G*8 
    27                  
    28                  ;TIMER 1 (50ms interrupt for 10s sound signal)
    29        0000      T1_G    EQU 0   ; GATE 
    30        0000      T1_C    EQU 0   ; COUNTER/-TIMER 
    31        0001      T1_M    EQU 1   ; MODE 1 (16-bit)
    32        0001      TIM1    EQU T1_M+T1_C*4+T1_G*8 
    33                  
    34        0011      TMOD_SET    EQU TIM0+TIM1*16
    35                  
    36                  ; 10[ms] = 10 000[uS]*(11.0592[MHz]/12) = 9 216 cycles = 36 * 256 
    37        00DC      TH0_SET     EQU 256-36
    38        0000      TL0_SET     EQU 0
    39                  
    40                  ; 50[ms] = 50 000[uS]*(11.0592[MHz]/12) = 46 080 cycles = 180 * 256
    41        004C      TH1_SET     EQU 256-180
    42        0000      TL1_SET     EQU 0
    43                  ;---------------------------------------
    44                  
    45        0095      BUZZ    EQU P1.5 ; Define Buzzer pin (Active Low) 
    46                  
    47                  ; Variables in the RAM
    48        0030      SEC_COUNT  EQU 30H ; Seconds counter (0-99)
    49        0031      CS_COUNT   EQU 31H ; Centiseconds counter (0-99)
    50        0032      T1_TICKS   EQU 32H ; Counter for 50ms ticks to reach 10s limit
    51        0033      BEEP_DUR   EQU 33H ; Counter for buzzer ON duration
    52                  
    53  0000: 02 01 00      LJMP START
    54                  
    55  000B:               ORG 0BH ; Timer 0 Interrupt Vector
    56  000B: 02 01 7D      LJMP TIMER0_ISR
    57                  
    58  001B:               ORG 1BH ; Timer 1 Interrupt Vector
    59  001B: 02 01 A7      LJMP TIMER1_ISR
    60                  
    61  0100:               ORG 100H ; Jump to the start of the program
    62                  
    63  0100:           START:
    64  0100: 12 81 08      LCALL LCD_INIT 
    65  0103: 12 81 0C      LCALL LCD_CLR 
    66                      
    67                      ; Setup TMOD mode for both timers
    68  0106: 75 89 11      MOV TMOD, #TMOD_SET
    69                      
    70                      ; Setup initial timer values
    71  0109: 75 8C DC      MOV TH0, #TH0_SET
    72  010C: 75 8A 00      MOV TL0, #TL0_SET
    73  010F: 75 8D 4C      MOV TH1, #TH1_SET
    74  0112: 75 8B 00      MOV TL1, #TL1_SET
    75                      
    76                      ; Initialize variables to 0
    77  0115: 75 30 00      MOV SEC_COUNT, #0
    78  0118: 75 31 00      MOV CS_COUNT, #0
    79  011B: 75 32 00      MOV T1_TICKS, #0
    80  011E: 75 33 00      MOV BEEP_DUR, #0
    81                      
    82  0121: D2 95         SETB BUZZ ; Turn off the Buzzer
    83                      
    84  0123: D2 AF         SETB EA  ; Global interrupt enable
    85  0125: D2 A9         SETB ET0 ; Enable Timer 0 interrupt
    86  0127: D2 AB         SETB ET1 ; Enable Timer 1 interrupt
    87                      
    88  0129: 12 01 57      LCALL DISPLAY_TIME ; Show "00,00" on the LCD
    89                  
    90  012C:           MAIN_LOOP:
    91  012C: 12 81 1C      LCALL WAIT_KEY
    92                      
    93                      ; Check if button 'A' (10) was pressed to start/pause the stopwatch
    94  012F: B4 0A 11      CJNE A, #10, CHECK_RESET
    95                      
    96                      ; Toggle the running state based on TR0 flag
    97  0132: 30 8C 08      JNB TR0, START_TIMERS
    98                      
    99  0135:           STOP_TIMERS:
   100  0135: C2 8C         CLR TR0
   101  0137: C2 8E         CLR TR1
   102  0139: D2 95         SETB BUZZ ; Turn off the Buzzer
   103                  
   104  013B: 80 EF         SJMP MAIN_LOOP
   105                  
   106  013D:           START_TIMERS:
   107  013D: D2 8C         SETB TR0
   108  013F: D2 8E         SETB TR1
   109                  
   110  0141: 80 E9         SJMP MAIN_LOOP
   111                  
   112  0143:           CHECK_RESET:
   113                      ; Check if button 'B' (11) was pressed to reset the stopwatch
   114  0143: B4 0B E6      CJNE A, #11, MAIN_LOOP
   115                      
   116                      ; Reset all counters and update the LCD back to "00,00"
   117  0146: 75 30 00      MOV SEC_COUNT, #0
   118  0149: 75 31 00      MOV CS_COUNT, #0
   119  014C: 75 32 00      MOV T1_TICKS, #0
   120  014F: 75 33 00      MOV BEEP_DUR, #0
   121                  
   122  0152: 12 01 57      LCALL DISPLAY_TIME
   123  0155: 80 D5         SJMP MAIN_LOOP
   124                  
   125  0157:           DISPLAY_TIME:
   126  0157: 74 80         MOV A, #80H 
   127  0159: 12 81 06      LCALL WRITE_INSTR
   128                      
   129  015C: E5 30         MOV A, SEC_COUNT
   130  015E: 12 01 6C      LCALL PRINT_DEC
   131                      
   132  0161: 74 2C         MOV A, #','
   133  0163: 12 81 02      LCALL WRITE_DATA
   134                      
   135  0166: E5 31         MOV A, CS_COUNT
   136  0168: 12 01 6C      LCALL PRINT_DEC
   137                  
   138  016B: 22            RET ; Return from subroutine
   139                  
   140  016C:           PRINT_DEC:
   141  016C: 75 F0 0A      MOV B, #10
   142  016F: 84            DIV AB
   143  0170: 24 30         ADD A, #'0'
   144  0172: 12 81 02      LCALL WRITE_DATA
   145  0175: E5 F0         MOV A, B
   146  0177: 24 30         ADD A, #'0'
   147  0179: 12 81 02      LCALL WRITE_DATA
   148                  
   149  017C: 22            RET 
   150                  
   151  017D:           TIMER0_ISR:
   152                      ; PUSH used registers to prevent corrupting the main program
   153  017D: C0 E0         PUSH ACC
   154  017F: C0 D0         PUSH PSW
   155  0181: C0 F0         PUSH B ; Register B is utilized inside the PRINT_DEC
   156                  
   157                      ; Reload timer 0 values for next 10ms tick
   158  0183: 75 8C DC      MOV TH0, #TH0_SET
   159  0186: 75 8A 00      MOV TL0, #TL0_SET
   160                      
   161                      ; Increase centiseconds
   162  0189: 05 31         INC CS_COUNT
   163  018B: E5 31         MOV A, CS_COUNT
   164  018D: B4 64 0D      CJNE A, #100, T0_ISR_END
   165                      
   166                      ; 100 Centiseconds = 1 Second
   167  0190: 75 31 00      MOV CS_COUNT, #0
   168  0193: 05 30         INC SEC_COUNT
   169  0195: E5 30         MOV A, SEC_COUNT
   170  0197: B4 64 03      CJNE A, #100, T0_ISR_END
   171                      
   172                      ; Roll over to 0 after 99 seconds
   173  019A: 75 30 00      MOV SEC_COUNT, #0
   174                  
   175  019D:           T0_ISR_END:
   176                      ; Update the LCD display with the new time values
   177  019D: 12 01 57      LCALL DISPLAY_TIME
   178                  
   179  01A0: D0 F0         POP B
   180  01A2: D0 D0         POP PSW
   181  01A4: D0 E0         POP ACC
   182                  
   183  01A6: 32            RETI ; Return from interrupt
   184                  
   185  01A7:           TIMER1_ISR:
   186  01A7: C0 E0         PUSH ACC
   187  01A9: C0 D0         PUSH PSW
   188                  
   189                      ; Reload timer 1 values for next 50ms tick
   190  01AB: 75 8D 4C      MOV TH1, #TH1_SET
   191  01AE: 75 8B 00      MOV TL1, #TL1_SET
   192                      
   193                      ; Check if the Buzzer is currently sounding
   194  01B1: E5 33         MOV A, BEEP_DUR
   195  01B3: 60 08         JZ T1_COUNT
   196                      
   197                      ; Decrease the remaining beep duration
   198  01B5: 15 33         DEC BEEP_DUR
   199  01B7: E5 33         MOV A, BEEP_DUR
   200  01B9: 70 02         JNZ T1_COUNT
   201                      
   202                      ; Beep duration has ended, turn off buzzer
   203  01BB: D2 95         SETB BUZZ
   204                  
   205  01BD:           T1_COUNT:
   206                      ; Increment the 50ms counter
   207  01BD: 05 32         INC T1_TICKS
   208  01BF: E5 32         MOV A, T1_TICKS
   209  01C1: B4 C8 08      CJNE A, #200, T1_ISR_END ; 200 ticks * 50ms = 10 000ms = 10s
   210                      
   211                      ; 10 seconds limit reached
   212  01C4: 75 32 00      MOV T1_TICKS, #0
   213  01C7: C2 95         CLR BUZZ ; Turn ON buzzer
   214  01C9: 75 33 04      MOV BEEP_DUR, #4 ; Beep will last for 4 * 50ms = 200ms
   215                  
   216  01CC:           T1_ISR_END:
   217  01CC: D0 D0         POP PSW
   218  01CE: D0 E0         POP ACC
   219                  
   220  01D0: 32            RETI
   221                  
   222  01D1:           STOP:
   223  01D1: 80 FE         SJMP $ 
